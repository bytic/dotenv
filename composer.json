{
  "name": "bytic/dotenv",
  "description": "bytic dotenv wrapper",
  "license": "MIT",
  "authors": [
    {
      "name": "Gabriel Solomon",
      "email": "hello@gabrielsolomon.ro"
    }
  ],
  "require": {
    "php": "^7.2.5 || ^8.0",
    "bytic/utility": "^1.0",
    "symfony/console": "^5.0 || ^6.0 || ^7.0 || ^8.0",
    "symfony/dotenv": "^5.0 || ^6.0 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^2.19 || ^3.0",
    "phpunit/phpunit": "^8.5 || ^9.6"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "ByTIC\\Dotenv\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ByTIC\\Dotenv\\Tests\\Fixtures\\": "tests/fixtures",
      "ByTIC\\Dotenv\\Tests\\": "tests/src"
    }
  }
}
